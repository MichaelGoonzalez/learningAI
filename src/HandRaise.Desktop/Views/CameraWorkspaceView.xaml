<UserControl x:Class="HandRaise.Desktop.Views.CameraWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             xmlns:controls="clr-namespace:HandRaise.Desktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1366">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER: Camera Identity, Operational State & Quick Actions -->
        <Border Grid.Row="0"
                Background="{DynamicResource VisionCardBackground}"
                BorderBrush="{DynamicResource VisionBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button Grid.Column="0"
                        Content="← Volver a Cámaras"
                        Command="{Binding DataContext.BackToCamerasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="12,6"
                        FontWeight="SemiBold"/>

                <!-- Camera Identity Breadcrumb -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cámaras" FontSize="13" Foreground="{DynamicResource VisionTextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="  /  " FontSize="13" Foreground="{DynamicResource VisionBorder}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedDetailCamera.Name}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VisionTextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  /  Superficie Operativa"
                               FontSize="13"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <components:StatusBadge Text="{Binding SelectedDetailCamera.Status}"
                                           Status="{Binding SelectedDetailCamera.Status}"
                                           VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Start/Stop Stream Action -->
                <Button Grid.Column="3"
                        Content="{Binding SelectedDetailCamera.ActionButtonText}"
                        Command="{Binding SelectedDetailCamera.ToggleRunningCommand}"
                        Padding="16,6"
                        FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- MAIN OPERATIONAL WORKSPACE: Video Protagonist Left (62%), Contextual Panel Right (38%) -->
        <Grid x:Name="CameraWorkspaceGrid" Grid.Row="1" Margin="16" DataContext="{Binding SelectedDetailCamera}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="38*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Live Video + Zone/Line Drawing Overlay + Activity Band -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video Display Frame -->
                <Border Grid.Row="0"
                        Background="#080A0D"
                        BorderBrush="{DynamicResource VisionBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Live Video Frame -->
                        <Image Source="{Binding VideoImage}" Stretch="Uniform"/>

                        <!-- Interactive Geometry Canvas Overlay -->
                        <controls:ZoneEditorOverlay Zones="{Binding EditorZones}"
                                                    Lines="{Binding EditorLines}"
                                                    DraftPoints="{Binding DraftPoints}"
                                                    Editing="{Binding IsEditingZones}"
                                                    FrameWidth="{Binding FrameWidth}"
                                                    FrameHeight="{Binding FrameHeight}"/>

                        <!-- Offline / Loading Placeholder -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}">
                            <Border Width="48" Height="48" Background="#161B22" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="16" Height="16" Background="#556677" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding CanonicalStateText, StringFormat='{}Estado: {0}'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#8899A6"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ContextualDiagnosticReason}"
                                       FontSize="12"
                                       Foreground="#556677"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="380"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Drawing Instructions Banner when Editing Geometry -->
                        <Border Background="#D9000000"
                                Padding="12,6"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsEditingZones, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding ZoneMessage, FallbackValue='📐 Modo dibujo activo: Haga clic sobre el video'}"
                                       Foreground="#FACC15"
                                       FontWeight="SemiBold"
                                       FontSize="11"/>
                        </Border>

                        <!-- Top-Left Video Status Badge -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Visibility="{Binding IsEditingZones, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}">
                            <components:StatusBadge Text="{Binding CanonicalStateText}" Status="{Binding CanonicalStateText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ACTIVITY & RESULTS BAND (Compact Bar Below Video) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource VisionCardBackground}"
                        BorderBrush="{DynamicResource VisionBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Activity Status -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActivitySummaryText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource VisionTextPrimary}"/>
                            <TextBlock Text="{Binding ActiveAnalyticsSummary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource VisionTextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Live FPS Telemetry -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FPS: " FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock Text="{Binding FramesPerSecond, StringFormat='{}{0:0.0}'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#10B981"/>
                        </StackPanel>

                        <!-- Resolution Telemetry -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Resolución: " FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} x {1}">
                                        <Binding Path="FrameWidth"/>
                                        <Binding Path="FrameHeight"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Contextual Configuration Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ======================================================== -->
                        <!-- CONTEXTUAL MODE 1: DIBUJAR ZONA POLIGONAL SOBRE EL VIDEO -->
                        <!-- ======================================================== -->
                        <StackPanel Visibility="{Binding IsCreatingContextualZone, Converter={StaticResource BooleanToVisibility}}">
                            <Border Background="{DynamicResource VisionSurface}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📐 DEFINIR ZONA SOBRE EL VIDEO"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource VisionAccent}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Haga clic directamente sobre el video a la izquierda para colocar al menos 3 vértices del polígono."
                                               FontSize="11"
                                               Foreground="{DynamicResource VisionTextSecondary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Nombre de la zona:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,0,0,10"/>

                            <Border Background="{DynamicResource VisionSurface}" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DraftPoints.Count, StringFormat='{}Vértices marcados: {0} (mínimo 3)'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource VisionTextPrimary}"/>
                            </Border>

                            <TextBlock Text="{Binding ZoneMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource VisionWarning}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding ZoneMessage, Converter={StaticResource BooleanToVisibility}}"/>

                            <!-- Geometry Action Buttons -->
                            <StackPanel Margin="0,0,0,12">
                                <Button Content="Guardar Zona"
                                        Command="{Binding SaveContextualZoneAndReturnCommand}"
                                        Padding="14,8"
                                        FontWeight="Bold"
                                        Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Cerrar Polígono" Command="{Binding CloseZoneCommand}" Padding="8,6" Background="{DynamicResource VisionSurface}"/>
                                    <Button Grid.Column="2" Content="Deshacer" Command="{Binding UndoZoneCommand}" Padding="8,6" Background="{DynamicResource VisionSurface}"/>
                                </Grid>
                                <Button Content="Cancelar"
                                        Command="{Binding CancelContextualGeometryAndReturnCommand}"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource VisionBorder}"
                                        Padding="10,6"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- CONTEXTUAL MODE 2: CREAR LÍNEA VIRTUAL (TRIPWIRE)        -->
                        <!-- ======================================================== -->
                        <StackPanel Visibility="{Binding IsCreatingContextualLine, Converter={StaticResource BooleanToVisibility}}">
                            <Border Background="{DynamicResource VisionSurface}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📏 DEFINIR LÍNEA VIRTUAL (TRIPWIRE)"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource VisionAccent}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Defina el identificador y el sentido de cruce para conteo o detección."
                                               FontSize="11"
                                               Foreground="{DynamicResource VisionTextSecondary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Nombre de la línea:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLineName, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,0,0,10"/>

                            <TextBlock Text="Sentido de detección:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding LineDirectionOptions}"
                                      SelectedItem="{Binding SelectedLineDirectionText}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding LineMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource VisionWarning}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding LineMessage, Converter={StaticResource BooleanToVisibility}}"/>

                            <!-- Line Action Buttons -->
                            <StackPanel Margin="0,0,0,12">
                                <Button Content="Guardar Línea"
                                        Command="{Binding SaveContextualLineAndReturnCommand}"
                                        Padding="14,8"
                                        FontWeight="Bold"
                                        Margin="0,0,0,8"/>
                                <Button Content="Cancelar"
                                        Command="{Binding CancelContextualGeometryAndReturnCommand}"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource VisionBorder}"
                                        Padding="10,6"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- NORMAL WORKSPACE MODE (When not drawing geometry)         -->
                        <!-- ======================================================== -->
                        <StackPanel Visibility="{Binding IsNormalMode, Converter={StaticResource BooleanToVisibility}}">

                            <!-- 1. SECCIÓN: SOLUCIONES IA -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Soluciones IA"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource VisionTextPrimary}"/>
                                    <TextBlock Text="Análisis computacional activo"
                                               FontSize="11"
                                               Foreground="{DynamicResource VisionTextSecondary}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="+ Agregar"
                                        Command="{Binding OpenAddAiModalCommand}"
                                        Padding="12,5"
                                        FontWeight="SemiBold"
                                        FontSize="11"/>
                            </Grid>

                            <!-- Empty State when no analytics active -->
                            <Border Background="{DynamicResource VisionSurface}"
                                    BorderBrush="{DynamicResource VisionBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding HasNoConfiguredAnalytics, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Esta cámara todavía no analiza la escena."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource VisionTextPrimary}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Active una solución para detectar personas, intrusiones en zonas o cruces de línea."
                                               FontSize="11"
                                               Foreground="{DynamicResource VisionTextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <Button Content="+ Agregar Solución IA"
                                            Command="{Binding OpenAddAiModalCommand}"
                                            Padding="12,6"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Configured Analytics Cards List -->
                            <ItemsControl ItemsSource="{Binding ConfiguredAnalytics}"
                                          Margin="0,0,0,16"
                                          Visibility="{Binding HasConfiguredAnalytics, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource VisionSurface}"
                                                BorderBrush="{DynamicResource VisionBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Title & Status -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DisplayName}"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource VisionTextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3"
                                                            Background="{Binding StatusBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Context Summary (e.g. Zona: Bodega) -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ContextSummary}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource VisionTextSecondary}"
                                                           Margin="0,4,0,8"/>

                                                <!-- Action Buttons: Pause/Resume, Delete -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <Button Content="{Binding ToggleText}"
                                                            Command="{Binding ToggleEnabledCommand}"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            Background="{DynamicResource VisionCardBackground}"
                                                            Margin="0,0,6,0"/>
                                                    <Button Content="Eliminar"
                                                            Command="{Binding RemoveCommand}"
                                                            Padding="8,4"
                                                            FontSize="11"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource VisionDanger}"
                                                            BorderThickness="0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{DynamicResource VisionBorder}" Margin="0,0,0,16"/>

                            <!-- 2. SECCIÓN: ESPACIOS (ZONAS Y LÍNEAS) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Espacios y Geometría"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource VisionTextPrimary}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+ Rectángulo"
                                            Command="{Binding StartDirectRectangleCreationCommand}"
                                            Padding="7,4"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Margin="0,0,4,0"/>
                                    <Button Content="+ Polígono"
                                            Command="{Binding StartDirectZoneCreationCommand}"
                                            Padding="7,4"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Margin="0,0,4,0"/>
                                    <Button Content="+ Línea"
                                            Command="{Binding StartDirectLineCreationCommand}"
                                            Padding="7,4"
                                            FontSize="10"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Zones List -->
                            <ItemsControl ItemsSource="{Binding EditorZones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource VisionSurface}" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📐 " FontSize="11"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                    <TextBlock Text="{Binding Points.Count, StringFormat='{} ({0} pts)'}" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        Command="{Binding DataContext.DeleteZoneItemCommand, ElementName=CameraWorkspaceGrid}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{DynamicResource VisionTextSecondary}"
                                                        Padding="4,1"
                                                        FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Lines List -->
                            <ItemsControl ItemsSource="{Binding EditorLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource VisionSurface}" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📏 " FontSize="11"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                    <TextBlock Text="{Binding DirectionMode, StringFormat='{} ({0})'}" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        Command="{Binding DataContext.DeleteLineItemCommand, ElementName=CameraWorkspaceGrid}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{DynamicResource VisionTextSecondary}"
                                                        Padding="4,1"
                                                        FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty spaces note -->
                            <TextBlock Text="Sin zonas ni líneas delimitadas."
                                       FontSize="11"
                                       Foreground="{DynamicResource VisionTextSecondary}"
                                       Margin="0,2,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                             <MultiDataTrigger>
                                                 <MultiDataTrigger.Conditions>
                                                     <Condition Binding="{Binding HasNoZones}" Value="True"/>
                                                     <Condition Binding="{Binding HasNoLines}" Value="True"/>
                                                 </MultiDataTrigger.Conditions>
                                                 <Setter Property="Visibility" Value="Visible"/>
                                             </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{DynamicResource VisionBorder}" Margin="0,8,0,14"/>

                            <!-- 3. SECCIÓN: REGLAS Y ALERTAS -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reglas y Alertas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource VisionTextPrimary}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="+ Agregar regla"
                                        Command="{Binding StartCreateRuleFromWorkspaceCommand}"
                                        Visibility="{Binding HasConfiguredAnalytics, Converter={StaticResource BooleanToVisibility}}"
                                        Padding="8,3"
                                        FontSize="10"
                                        FontWeight="SemiBold"/>
                            </Grid>

                            <!-- State when no AI solutions active -->
                            <Border Background="{DynamicResource VisionSurface}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding HasNoConfiguredAnalytics, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="Agregue una Solución IA antes de crear reglas."
                                           FontSize="11"
                                           Foreground="{DynamicResource VisionTextSecondary}"/>
                            </Border>

                            <!-- State when AI solutions exist but no rules configured -->
                            <Border Background="{DynamicResource VisionSurface}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasConfiguredAnalytics}" Value="True"/>
                                                    <Condition Binding="{Binding HasNoConfiguredRules}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Sin reglas de alerta configuradas."
                                               FontSize="11"
                                               Foreground="{DynamicResource VisionTextSecondary}"
                                               Margin="0,0,0,6"/>
                                    <Button Content="+ Agregar Regla de Alerta"
                                            Command="{Binding StartCreateRuleFromWorkspaceCommand}"
                                            Padding="10,4"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- List of configured rules -->
                            <ItemsControl ItemsSource="{Binding ConfiguredRules}"
                                          Margin="0,0,0,14"
                                          Visibility="{Binding HasConfiguredRules, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource VisionSurface}"
                                                BorderBrush="{DynamicResource VisionBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: Name + Severity Badge -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource VisionTextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            Background="{Binding SeverityBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SeverityText}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Row 1: Event Trigger + Analytic Context -->
                                                <StackPanel Grid.Row="1" Margin="0,4,0,6">
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource VisionTextSecondary}">
                                                        <Run Text="Disparador: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding EventTypesText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,1,0,0">
                                                        <Run Text="Solución: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding AnalyticDisplayName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="Espera: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding CooldownText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Row 2: Actions -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <Button Content="Editar"
                                                            Command="{Binding DataContext.StartEditRuleFromWorkspaceCommand, ElementName=CameraWorkspaceGrid}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,3"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Background="{DynamicResource VisionCardBackground}"
                                                            Margin="0,0,6,0"/>
                                                    <Border Background="Transparent"
                                                            CornerRadius="4"
                                                            Padding="4,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource VisionTextSecondary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{DynamicResource VisionBorder}" Margin="0,0,0,14"/>

                            <!-- 4. SECCIÓN: AJUSTES DE CÁMARA (Compacto) -->
                            <TextBlock Text="Ajustes de Cámara"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource VisionTextPrimary}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Nombre descriptivo:" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>

                            <TextBlock Text="Fuente de video:" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditSource, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>

                            <CheckBox Content="Iniciar transmisión automáticamente"
                                      IsChecked="{Binding EditEnabled}"
                                      FontSize="11"
                                      Margin="0,0,0,10"/>

                            <Button Content="Guardar Ajustes"
                                    Command="{Binding SaveConfigCommand}"
                                    Padding="12,6"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding ConfigMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource VisionAccent}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding ConfigMessage, Converter={StaticResource BooleanToVisibility}}"/>

                            <!-- Collapsible Más opciones (Danger Zone) -->
                            <Expander Header="Más opciones"
                                      IsExpanded="{Binding IsDangerZoneExpanded}"
                                      Foreground="{DynamicResource VisionTextSecondary}"
                                      FontSize="11"
                                      Margin="0,4,0,16">
                                <Border Background="{DynamicResource VisionSurface}"
                                        BorderBrush="{DynamicResource VisionDanger}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Eliminar Cámara Permanentemente"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource VisionDanger}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Esta acción removerá la cámara, sus zonas, reglas y configuraciones asociadas."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource VisionTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <Button Content="Eliminar Cámara"
                                                Command="{Binding DataContext.DeleteCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource VisionDanger}"
                                                Foreground="White"
                                                Padding="12,6"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================================================================== -->
        <!-- MODAL COMPACTO: AGREGAR SOLUCIÓN IA (Sin scroll a 1366x768)          -->
        <!-- ==================================================================== -->
        <Grid Grid.RowSpan="2"
              Background="#99000000"
              DataContext="{Binding SelectedDetailCamera}"
              Visibility="{Binding IsAddAiModalOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Width="520"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <!-- STEP 1: ¿QUÉ QUIERES DETECTAR? (Human Cards) -->
                    <StackPanel Visibility="{Binding IsAiWizardStep1, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Agregar Solución IA"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource VisionTextPrimary}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="¿Qué tipo de actividad deseas detectar en esta cámara?"
                                   FontSize="12"
                                   Foreground="{DynamicResource VisionTextSecondary}"
                                   Margin="0,0,0,16"/>

                        <!-- Human Solution Cards -->
                        <StackPanel Margin="0,0,0,16">
                            <!-- Card 1: Person Presence -->
                                    <Button Margin="0,0,0,8"
                                            Padding="14,10"
                                            HorizontalContentAlignment="Left"
                                            Background="{DynamicResource VisionSurface}"
                                            BorderBrush="{DynamicResource VisionBorder}"
                                            BorderThickness="1"
                                            Command="{Binding SelectCatalogAnalyticAndNextCommand}"
                                            CommandParameter="person_presence">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="👤" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Detección de Personas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                <TextBlock Text="Detecta presencia y tiempo de permanencia en la escena o zona." FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 2: Zone Intrusion -->
                                    <Button Margin="0,0,0,8"
                                            Padding="14,10"
                                            HorizontalContentAlignment="Left"
                                            Background="{DynamicResource VisionSurface}"
                                            BorderBrush="{DynamicResource VisionBorder}"
                                            BorderThickness="1"
                                            Command="{Binding SelectCatalogAnalyticAndNextCommand}"
                                            CommandParameter="zone_intrusion">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🛑" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Intrusión en Zona" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                <TextBlock Text="Genera alertas al ingresar a un área restringida delimitada." FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 3: Line Crossing -->
                                    <Button Margin="0,0,0,8"
                                            Padding="14,10"
                                            HorizontalContentAlignment="Left"
                                            Background="{DynamicResource VisionSurface}"
                                            BorderBrush="{DynamicResource VisionBorder}"
                                            BorderThickness="1"
                                            Command="{Binding SelectCatalogAnalyticAndNextCommand}"
                                            CommandParameter="line_crossing">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="↔️" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cruce de Línea Virtual" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                <TextBlock Text="Detecta paso a través de una línea virtual y determina su sentido." FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 4: Person Counting -->
                                    <Button Margin="0,0,0,8"
                                            Padding="14,10"
                                            HorizontalContentAlignment="Left"
                                            Background="{DynamicResource VisionSurface}"
                                            BorderBrush="{DynamicResource VisionBorder}"
                                            BorderThickness="1"
                                            Command="{Binding SelectCatalogAnalyticAndNextCommand}"
                                            CommandParameter="person_counting">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔢" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Conteo de Personas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                <TextBlock Text="Mantiene balance de flujo con conteo de entradas y salidas." FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 5: Hand Raise -->
                                    <Button Padding="14,10"
                                            HorizontalContentAlignment="Left"
                                            Background="{DynamicResource VisionSurface}"
                                            BorderBrush="{DynamicResource VisionBorder}"
                                            BorderThickness="1"
                                            Command="{Binding SelectCatalogAnalyticAndNextCommand}"
                                            CommandParameter="hand_raise">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✋" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Mano Levantada" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                <TextBlock Text="Detecta personas con la mano alzada por encima del hombro." FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Step 1 Footer -->
                                <Button Content="Cancelar"
                                        Command="{Binding CloseAddAiModalCommand}"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource VisionBorder}"
                                        Padding="14,7"
                                        HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- STEP 2: CONFIGURACIÓN COMPACTA (Data-Driven, No Scroll) -->
                            <StackPanel Visibility="{Binding IsAiWizardStep2, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{Binding SelectedCatalogAnalytic.DisplayName, StringFormat='{}Configurar {0}'}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource VisionTextPrimary}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Ajuste los parámetros operativos para esta cámara:"
                                           FontSize="11"
                                           Foreground="{DynamicResource VisionTextSecondary}"
                                           Margin="0,0,0,12"/>

                                <!-- Instance Name -->
                                <TextBlock Text="Nombre descriptivo:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding AiCustomName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"/>

                                <!-- ========================================== -->
                                <!-- ÁREA DE ANÁLISIS: CASO 1: ZONA OPCIONAL     -->
                                <!-- ========================================== -->
                                <StackPanel Visibility="{Binding AllowsOptionalZone, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,10">
                                    <TextBlock Text="Área de análisis:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton Content="Toda la imagen"
                                                     IsChecked="{Binding IsFullImageAnalysis}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource VisionTextPrimary}"
                                                     Margin="0,0,16,0"/>
                                        <RadioButton Content="Área específica"
                                                     IsChecked="{Binding IsSpecificAreaAnalysis}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource VisionTextPrimary}"/>
                                    </StackPanel>

                                    <!-- Sub-panel when Specific Area is checked -->
                                    <Grid Visibility="{Binding IsSpecificAreaAnalysis, Converter={StaticResource BooleanToVisibility}}" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding EditorZones}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding SelectedTargetZoneName}"
                                                  SelectedValuePath="Name"/>
                                        <Button Grid.Column="2"
                                                Content="+ Rectángulo"
                                                Command="{Binding StartContextualRectangleCreationCommand}"
                                                Padding="8,5"
                                                FontSize="10"
                                                FontWeight="SemiBold"/>
                                        <Button Grid.Column="4"
                                                Content="+ Polígono"
                                                Command="{Binding StartContextualZoneCreationCommand}"
                                                Padding="8,5"
                                                FontSize="10"
                                                FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- ========================================== -->
                                <!-- ÁREA DE ANÁLISIS: CASO 2: ZONA REQUERIDA    -->
                                <!-- ========================================== -->
                                <StackPanel Visibility="{Binding RequiresZone, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,10">
                                    <TextBlock Text="Zona requerida para supervisión:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding EditorZones}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding SelectedTargetZoneName}"
                                                  SelectedValuePath="Name"/>
                                        <Button Grid.Column="2"
                                                Content="+ Rectángulo"
                                                Command="{Binding StartContextualRectangleCreationCommand}"
                                                Padding="8,5"
                                                FontSize="10"
                                                FontWeight="SemiBold"/>
                                        <Button Grid.Column="4"
                                                Content="+ Polígono"
                                                Command="{Binding StartContextualZoneCreationCommand}"
                                                Padding="8,5"
                                                FontSize="10"
                                                FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- ========================================== -->
                                <!-- ÁREA DE ANÁLISIS: CASO 3: LÍNEA REQUERIDA   -->
                                <!-- ========================================== -->
                                <StackPanel Visibility="{Binding RequiresLine, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,10">
                                    <TextBlock Text="Línea virtual asignada:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding EditorLines}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding SelectedTargetLineId}"
                                                  SelectedValuePath="Id"/>
                                        <Button Grid.Column="2"
                                                Content="+ Crear línea"
                                                Command="{Binding StartContextualLineCreationCommand}"
                                                Padding="8,5"
                                                FontSize="10"
                                                FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- ======================================================= -->
                                <!-- DYNAMIC PARAMETERS: 100% Data-Driven from Analytic Catalog -->
                                <!-- ======================================================= -->
                                <ItemsControl ItemsSource="{Binding DynamicParameters}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <!-- Boolean Template -->
                                                <StackPanel Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibility}}">
                                                    <CheckBox Content="{Binding Label}"
                                                              IsChecked="{Binding BoolValue}"
                                                              FontSize="11"
                                                              FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource VisionTextSecondary}"
                                                               Margin="20,2,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Number Template (Slider + Numeric Readout) -->
                                                <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibility}}">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                        <TextBlock Text="{Binding FormattedNumberValue}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource VisionAccent}"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider Value="{Binding NumberValue}"
                                                            Minimum="{Binding Min}"
                                                            Maximum="{Binding Max}"
                                                            SmallChange="{Binding Step}"
                                                            LargeChange="{Binding Step}"
                                                            Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource VisionTextSecondary}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Select / Dropdown Template -->
                                                <StackPanel Visibility="{Binding IsSelect, Converter={StaticResource BooleanToVisibility}}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,2"/>
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding SelectedOptionValue}"
                                                              Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource VisionTextSecondary}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- String Template -->
                                                <StackPanel Visibility="{Binding IsString, Converter={StaticResource BooleanToVisibility}}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource VisionTextSecondary}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Error Message -->
                                <TextBlock Text="{Binding AddAiError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource VisionDanger}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Visibility="{Binding HasAddAiError, Converter={StaticResource BooleanToVisibility}}"/>

                                <!-- Step 2 Footer Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="← Cambiar tipo"
                                            Command="{Binding PrevAiWizardStepCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource VisionTextSecondary}"
                                            Padding="6,6"
                                            FontSize="11"/>
                                    <Button Grid.Column="2"
                                            Content="Cancelar"
                                            Command="{Binding CloseAddAiModalCommand}"
                                            Background="{DynamicResource VisionSurface}"
                                            Padding="12,7"
                                            FontSize="11"/>
                                    <Button Grid.Column="4"
                                            Content="Activar Solución IA"
                                            Command="{Binding ConfirmAddAiSolutionCommand}"
                                            Padding="16,7"
                                            FontWeight="Bold"
                                            FontSize="11"/>
                                </Grid>
                            </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================================================================== -->
        <!-- MODAL COMPACTO: REGLAS Y ALERTAS OPERACIONALES (Workspace Unificado) -->
        <!-- ==================================================================== -->
        <Grid Grid.RowSpan="2"
              Background="#99000000"
              DataContext="{Binding SelectedDetailCamera}"
              Visibility="{Binding IsRulesModalOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Width="560"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <!-- VIEW 1: RULES LIST (When IsViewingRulesList) -->
                    <StackPanel Visibility="{Binding IsViewingRulesList, Converter={StaticResource BooleanToVisibility}}">
                        <!-- Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reglas de Alerta Operativa"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource VisionTextPrimary}"/>
                                <TextBlock Text="Configure disparadores de alerta automática para esta cámara."
                                           FontSize="11"
                                           Foreground="{DynamicResource VisionTextSecondary}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseRulesModalCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource VisionTextSecondary}"
                                    FontSize="14"
                                    Padding="6,2"/>
                        </Grid>

                        <!-- Instance Selector (Visible if > 1 analytic) -->
                        <StackPanel Visibility="{Binding HasMultipleAssignedAnalytics, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12">
                            <TextBlock Text="Solución IA a configurar:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AssignedAnalytics}"
                                      SelectedItem="{Binding SelectedRuleAnalytic}"
                                      DisplayMemberPath="DisplayName"/>
                        </StackPanel>

                        <!-- Single Instance Readout (Visible if exactly 1 analytic) -->
                        <Border Visibility="{Binding HasSingleAssignedAnalytic, Converter={StaticResource BooleanToVisibility}}"
                                Background="{DynamicResource VisionSurface}"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedRuleAnalytic.Icon}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Solución IA: " FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                <TextBlock Text="{Binding SelectedRuleAnalytic.DisplayName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VisionTextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <!-- List Header + Create Button -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Reglas activas" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="+ Crear regla"
                                    Command="{Binding StartCreateRuleCommand}"
                                    Padding="10,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Rules List -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding CameraRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource VisionSurface}"
                                                    BorderBrush="{DynamicResource VisionBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                            <Border Background="{Binding SeverityBrush}"
                                                                    CornerRadius="4"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SeverityText}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Evento: " FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                            <TextBlock Text="{Binding EventTypesText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" Margin="0,0,12,0"/>
                                                            <TextBlock Text="Espera: " FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                            <TextBlock Text="{Binding CooldownText}" FontSize="10" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Actions: Edit & Delete -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Editar"
                                                                Command="{Binding EditCommand}"
                                                                Padding="8,4"
                                                                FontSize="11"
                                                                Background="{DynamicResource VisionCardBackground}"
                                                                Margin="0,0,6,0"/>
                                                        <Button Content="✕"
                                                                Command="{Binding DeleteCommand}"
                                                                Padding="6,4"
                                                                FontSize="11"
                                                                Background="Transparent"
                                                                Foreground="{DynamicResource VisionDanger}"
                                                                BorderThickness="0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State when no rules -->
                                <Border Background="{DynamicResource VisionSurface}"
                                        CornerRadius="6"
                                        Padding="16"
                                        Visibility="{Binding HasNoCameraRules, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="No hay reglas configuradas para esta solución. Pulse '+ Crear regla' para generar alertas."
                                               FontSize="11"
                                               Foreground="{DynamicResource VisionTextSecondary}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Error display if any -->
                        <TextBlock Text="{Binding RuleErrorMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource VisionDanger}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding HasRuleError, Converter={StaticResource BooleanToVisibility}}"/>

                        <!-- Footer -->
                        <Button Content="Cerrar"
                                Command="{Binding CloseRulesModalCommand}"
                                Padding="14,6"
                                HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- VIEW 2: CREATE / EDIT RULE FORM (When IsEditingRule) -->
                    <StackPanel Visibility="{Binding IsEditingRule, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{Binding RuleFormTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource VisionTextPrimary}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Defina la condición y severidad para emitir alertas operacionales:"
                                   FontSize="11"
                                   Foreground="{DynamicResource VisionTextSecondary}"
                                   Margin="0,0,0,12"/>

                        <!-- Rule Name -->
                        <TextBlock Text="Nombre descriptivo:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding RuleEditName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"/>

                        <!-- Event Type (100% Data-Driven from Analytic Definition) -->
                        <TextBlock Text="Evento disparador:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableRuleEventOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding RuleEditEventType}"
                                  Margin="0,0,0,10"/>

                        <!-- Severity & Cooldown in 2 columns -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Severidad:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding SeverityOptions}"
                                          SelectedItem="{Binding RuleEditSeverity}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tiempo de espera entre alertas (segundos):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding RuleEditCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Enabled Checkbox -->
                        <CheckBox Content="Habilitar regla inmediatamente"
                                  IsChecked="{Binding RuleEditEnabled}"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,12"/>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding RuleErrorMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource VisionDanger}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding HasRuleError, Converter={StaticResource BooleanToVisibility}}"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Cancelar"
                                    Command="{Binding CancelEditRuleCommand}"
                                    Background="{DynamicResource VisionSurface}"
                                    Padding="12,6"
                                    FontSize="11"/>
                            <Button Grid.Column="2"
                                    Content="Guardar Regla"
                                    Command="{Binding SaveRuleCommand}"
                                    Padding="16,6"
                                    FontWeight="Bold"
                                    FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
