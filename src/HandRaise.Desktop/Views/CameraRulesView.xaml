<UserControl x:Class="HandRaise.Desktop.Views.CameraRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reglas de Alerta Operativa"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VisionTextPrimary}"/>
                    <TextBlock Text="Automatice la generación de alertas operacionales a partir de eventos detectados por IA"
                               FontSize="12"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Progressive Empty State: No AI Solutions -->
            <components:EmptyState Title="Requiere una Solución IA"
                                   Description="Esta cámara no tiene soluciones IA activas. Configure primero una analítica para definir reglas de alerta."
                                   ActionText="+ Configurar Solución IA"
                                   ActionCommand="{Binding OpenAddAiModalCommand}"
                                   Visibility="{Binding HasNoConfiguredAnalytics, Converter={StaticResource BooleanToVisibility}}"
                                   Margin="0,0,0,20"/>

            <!-- Active Rules Template List (When AI solutions exist) -->
            <StackPanel Visibility="{Binding HasConfiguredAnalytics, Converter={StaticResource BooleanToVisibility}}">
                <!-- Info Banner -->
                <Border Background="{DynamicResource VisionCardBackground}"
                        BorderBrush="{DynamicResource VisionBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="4" Height="28" Background="{DynamicResource VisionAccent}" CornerRadius="2" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EVALUACIÓN CONTINUA DE REGLAS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock Text="Las reglas procesan las detecciones en vivo de las soluciones IA configuradas. Cuando una condición se satisface, se dispara una alerta con la severidad y periodicidad establecidas."
                                       FontSize="12"
                                       Foreground="{DynamicResource VisionTextPrimary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rule Template Cards for Configured Analytics -->
                <ItemsControl ItemsSource="{Binding ConfiguredAnalytics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource VisionCardBackground}"
                                    BorderBrush="{DynamicResource VisionBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Rule Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Regla Automática: " FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionTextPrimary}"/>
                                            <TextBlock Text="{Binding Name, StringFormat='{}Alerta por {0}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource VisionAccent}"/>
                                        </StackPanel>

                                        <components:StatusBadge Grid.Column="1" Text="Monitoreando" Status="Normal"/>
                                    </Grid>

                                    <!-- Rule Template Content (Human-readable logic) -->
                                    <Border Grid.Row="2" Background="{DynamicResource VisionSurface}" CornerRadius="6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Cuando: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Espacio: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                    <TextBlock Text="{Binding TargetZoneName, TargetNullValue='(Toda la escena de la cámara)'}" FontSize="11" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Severidad: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                    <TextBlock Text="Alta" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource VisionWarning}" Margin="0,0,16,0"/>

                                                    <TextBlock Text="Tiempo de espera entre alertas: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                                    <TextBlock Text="5 segundos" FontSize="11" Foreground="{DynamicResource VisionTextPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Link to Monitor -->
                                            <Button Grid.Column="1"
                                                    Content="Ver en Monitor"
                                                    Command="{Binding DataContext.GoToMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="{DynamicResource VisionCardBackground}"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

