<UserControl x:Class="HandRaise.Desktop.Views.TrainingLabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:HandRaise.Desktop.Controls" Foreground="{DynamicResource VisionTextPrimary}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="Entrenamiento de Modelos" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}"/>
   <TextBlock Text="Enseñe a VisionControl a reconocer sus objetos con ejemplos." Foreground="{DynamicResource VisionTextSecondary}"/>
   <StackPanel Visibility="{Binding NeedsPreparation, Converter={StaticResource BooleanToVisibility}}" Margin="0,10,0,0">
    <TextBlock Text="Preparar entorno de entrenamiento" FontWeight="SemiBold"/>
    <TextBlock Text="VisionControl necesita preparar una vez los componentes necesarios para entrenar modelos." TextWrapping="Wrap"/>
    <TextBlock Text="Se descargarán el motor de entrenamiento, sus componentes CPU/GPU y el modelo inicial." TextWrapping="Wrap"/>
    <TextBlock Text="{Binding PreparationSize}"/>
    <WrapPanel Margin="0,6">
     <Button Content="{Binding PreparationActionText}" Command="{Binding PrepareRuntimeCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
     <Button Content="Cancelar preparación" Command="{Binding CancelPreparationCommand}" IsEnabled="{Binding IsPreparingRuntime}"/>
    </WrapPanel>
    <ProgressBar Value="{Binding PreparationPercent, Mode=OneWay}" Maximum="100" Height="8"/>
    <TextBlock Text="{Binding PreparationPercent, StringFormat={}{0:F0}%}"/>
   </StackPanel>
   <TextBlock Text="{Binding Runtime}" TextWrapping="Wrap" Margin="0,6"/>
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsCheckingRuntime, Converter={StaticResource BooleanToVisibility}}"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
     <Button Content="Crear modelo" Command="{Binding NewCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,8"/>
     <Button Content="Verificación profunda" Command="{Binding DeepCheckCommand}" IsEnabled="{Binding CanEdit}"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanSelectProject}" Background="{DynamicResource VisionCardBackground}">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,8" MaxWidth="205">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Objects}" TextWrapping="Wrap" FontSize="12"/>
      <TextBlock Text="{Binding State}" Foreground="{DynamicResource VisionAccent}"/>
      <TextBlock Text="{Binding Modified}" FontSize="11"/><TextBlock Text="{Binding Version}" FontSize="11"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Background="{DynamicResource VisionCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <StackPanel IsEnabled="{Binding CanEdit}">
       <TextBlock Text="Nombre del modelo" FontWeight="SemiBold"/>
       <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
       <TextBlock Text="¿Qué quieres que VisionControl aprenda a reconocer?" FontWeight="SemiBold"/>
       <TextBlock Text="Un objeto por línea. Para renombrarlo, edite su línea conservando el orden." FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
       <TextBox Text="{Binding ClassNames, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,5,0,12"/>
       <Button Content="Guardar modelo" Command="{Binding SaveProjectCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
     <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibility}}">
      <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,0,0,12">
       <Button Content="Agregar imágenes" Command="{Binding ImportImagesCommand}" Margin="0,0,8,6"/>
       <Button Content="Agregar carpeta" Command="{Binding ImportFolderCommand}" Margin="0,0,8,6"/>
       <Button Content="Agregar video" Command="{Binding ImportVideoCommand}" Margin="0,0,8,6"/>
      </WrapPanel>
      <TextBlock Text="La captura desde cámara estará disponible en una fase posterior." FontSize="11" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding ImageStatus}" Margin="0,0,0,6"/>
      <controls:TrainingBoxEditor Image="{Binding Image}" Boxes="{Binding Boxes}" Classes="{Binding Classes}" ActiveClass="{Binding ActiveClass}" SelectedIndex="{Binding SelectedBox}" CanEdit="{Binding CanLabel}" Height="380"/>
      <TextBlock Text="Arrastre para crear un rectángulo. Selecciónelo para moverlo; arrastre su esquina inferior derecha para cambiar el tamaño." TextWrapping="Wrap" FontSize="11" Margin="0,6,0,8"/>
      <WrapPanel IsEnabled="{Binding CanLabel}" Margin="0,0,0,8">
       <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding ActiveClass}" DisplayMemberPath="Name" MinWidth="130" Margin="0,0,8,6"/>
       <Button Content="Cambiar objeto" Command="{Binding ChangeClassCommand}" Margin="0,0,8,6"/>
       <Button Content="Eliminar rectángulo" Command="{Binding DeleteBoxCommand}" Margin="0,0,8,6"/>
       <Button Content="Anterior" Command="{Binding PreviousCommand}" Margin="0,0,8,6"/>
       <Button Content="Siguiente" Command="{Binding NextCommand}" Margin="0,0,8,6"/>
       <Button Content="Marcar como revisada" Command="{Binding ReviewCommand}" Margin="0,0,8,6"/>
      </WrapPanel>
      <TextBlock Text="Sin rectángulos, «Marcar como revisada» confirma un ejemplo sin objetos." FontSize="11" Margin="0,0,0,12"/>
      <Button Content="Volver a los ejemplos" Command="{Binding ReturnToEditorCommand}" Visibility="{Binding IsPreview, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <Border Background="{DynamicResource VisionCardBackground}" CornerRadius="8" Padding="16">
       <StackPanel>
        <TextBlock Text="Preparar y entrenar" FontWeight="SemiBold" FontSize="18"/>
        <TextBlock Text="{Binding Runtime}" TextWrapping="Wrap" Margin="0,8"/>
        <TextBlock Text="{Binding ResourceWarning}" TextWrapping="Wrap" Foreground="{DynamicResource VisionTextSecondary}"/>
        <TextBlock Text="Procesamiento para entrenamiento" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock Text="GPU: más rápido para entrenamiento. Puede reducir temporalmente el rendimiento gráfico disponible para otras tareas." TextWrapping="Wrap"/>
        <TextBlock Text="CPU: compatible con cualquier equipo, pero normalmente más lento." TextWrapping="Wrap"/>
        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" Margin="0,8">
         <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding Available}"/></Style></ComboBox.ItemContainerStyle>
        </ComboBox>
        <TextBlock Text="Comprobando GPU..." TextWrapping="Wrap" Visibility="{Binding IsCheckingDevices, Converter={StaticResource BooleanToVisibility}}"/>
        <TextBlock Text="Este equipo no dispone actualmente de una GPU compatible con el entorno de entrenamiento." TextWrapping="Wrap" Visibility="{Binding GpuUnavailable, Converter={StaticResource BooleanToVisibility}}"/>
        <WrapPanel IsEnabled="{Binding CanEdit}">
         <Button Content="Usar CPU" Command="{Binding UseCpuCommand}" Margin="0,0,8,0"/>
         <Button Content="Comprobar dispositivos" Command="{Binding CheckDevicesCommand}" Margin="0,0,8,0"/>
         <Button Content="Verificación profunda" Command="{Binding DeepCheckCommand}"/>
        </WrapPanel>
        <ComboBox SelectedIndex="{Binding ProfileIndex}" IsEnabled="{Binding CanEdit}" Margin="0,8">
         <ComboBoxItem Content="Rápido"/><ComboBoxItem Content="Equilibrado — recomendado"/><ComboBoxItem Content="Mayor precisión"/>
        </ComboBox>
        <WrapPanel><Button Content="Revisar preparación" Command="{Binding PrepareCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,8"/>
         <Button Content="Iniciar entrenamiento" Command="{Binding TrainCommand}" IsEnabled="{Binding CanTrain}" Margin="0,0,8,8"/>
         <Button Content="Cancelar entrenamiento" Command="{Binding CancelCommand}" IsEnabled="{Binding IsTraining}" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Text="{Binding Stage}"/>
        <TextBlock Text="{Binding TrainingActivity}" TextWrapping="Wrap" Foreground="{DynamicResource VisionTextSecondary}"/>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsTrainingProgressIndeterminate, Mode=OneWay}" Maximum="100" Height="8" Margin="0,6"/>
        <TextBlock Text="{Binding TrainingProgressText}"/>
        <TextBlock Text="Al terminar se publica una versión validada. Después usted decide en qué cámara usarla." FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <StackPanel Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
       <TextBlock Text="Modelo listo" FontSize="18" FontWeight="SemiBold"/>
       <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" DisplayMemberPath="Label" IsEnabled="{Binding CanSelectProject}" Margin="0,8"/>
       <TextBlock Text="{Binding VersionMetrics}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <WrapPanel><Button Content="Probar modelo" Command="{Binding TestCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,8"/>
        <Button Content="Usar en VisionControl" Command="{Binding UseCommand}" Margin="0,0,0,8"/></WrapPanel>
       <TextBlock Text="Elija una cámara, abra Solución IA y seleccione Detección de objetos personalizada, modelo y versión. Guarde para aplicarlo." TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
      <Expander Header="Historial" Margin="0,12"><ItemsControl ItemsSource="{Binding History}"/></Expander>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource VisionTextPrimary}"/>
   <Expander Header="Detalles técnicos"><StackPanel>
    <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
    <Button Content="Abrir registro completo" Command="{Binding OpenTrainingLogCommand}" IsEnabled="{Binding HasWorkerLog}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
   </StackPanel></Expander>
  </StackPanel>
 </Grid>
</UserControl>
