<UserControl x:Class="HandRaise.Desktop.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Modelos de Inferencia y Runtimes"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VisionTextPrimary}"/>
                    <TextBlock Text="Catálogo de redes neuronales ONNX, backends de aceleración y capacidades"
                               FontSize="12"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Actualizar"
                        Command="{Binding RefreshModelsCommand}"
                        Padding="14,6"
                        FontWeight="SemiBold"/>
            </Grid>

            <!-- Empty State -->
            <components:EmptyState Title="No hay modelos cargados"
                                   Description="No se encontraron modelos de visión computacional en el registro local del sistema."
                                   Visibility="{Binding HasNoModels, Converter={StaticResource BooleanToVisibility}}"
                                   Margin="0,0,0,20"/>

            <!-- Models List -->
            <ItemsControl ItemsSource="{Binding Models}"
                          Visibility="{Binding HasModels, Converter={StaticResource BooleanToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource VisionCardBackground}"
                                BorderBrush="{DynamicResource VisionBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Row -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource VisionTextPrimary}"/>
                                        <TextBlock Text="{Binding Id, StringFormat='{}ID: {0}'}" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource VisionSurface}" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding Version, StringFormat='{}v{0}'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource VisionTextPrimary}"/>
                                    </Border>
                                </Grid>

                                <!-- Metadata Columns -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Formato:" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                        <TextBlock Text="{Binding Format}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionTextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Resolución:" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                        <TextBlock Text="{Binding Resolution}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionTextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Memoria Est.:" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                        <TextBlock Text="{Binding MemoryMb}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionTextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Capacidades:" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                        <TextBlock Text="{Binding CapabilitiesSummary}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionAccent}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

