<UserControl x:Class="HandRaise.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- Header with Title & Quick Action -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Panel de Control"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VisionTextPrimary}"/>
                    <TextBlock Text="Estado global del sistema de visión artificial y telemetría en tiempo real"
                               FontSize="12"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="+ Agregar Cámara"
                        Command="{Binding ShowAddCameraModalCommand}"
                        Padding="16,8"
                        FontWeight="SemiBold"/>
            </Grid>

            <!-- 4 Compact KPI Cards Row -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <components:MetricCard Title="CÁMARAS ACTIVAS"
                                      Value="{Binding RunningCamerasCount}"
                                      Subtitle="{Binding TotalCamerasCount, StringFormat='{}de {0} configuradas'}"
                                      Margin="0,0,12,0"/>
                <components:MetricCard Title="SOLUCIONES IA"
                                      Value="{Binding TotalActiveAnalyticsCount}"
                                      Subtitle="En ejecución simultánea"
                                      Margin="0,0,12,0"/>
                <components:MetricCard Title="RENDIMIENTO GLOBAL"
                                      Value="{Binding AggregateFps, StringFormat='{}{0:0.0} FPS'}"
                                      Subtitle="{Binding CapacityStateText, StringFormat='{}Capacidad: {0}'}"
                                      Margin="0,0,12,0"/>
                <components:MetricCard Title="ESTADO DEL NODO"
                                      Value="{Binding NodeStatusText}"
                                      Subtitle="{Binding ProcessorText, StringFormat='{}Acelerador: {0}'}"/>
            </UniformGrid>

            <!-- Quick Navigation Shortcuts Bar -->
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Acciones Rápidas de Operación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource VisionTextPrimary}"/>
                        <TextBlock Text="Accede directamente a la administración de cámaras o a la supervisión técnica" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Administrar Cámaras"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="1"
                                Padding="14,7"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"/>
                        <Button Content="Supervisar Métricas"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="2"
                                Background="{DynamicResource VisionSurface}"
                                Padding="14,7"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resumen Operacional de Cámaras -->
            <TextBlock Text="Estado Operacional de Cámaras"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VisionTextPrimary}"
                       Margin="0,0,0,12"/>

            <!-- Cameras Status Grid (Sin decodificación continua de video) -->
            <ItemsControl ItemsSource="{Binding Cameras}"
                          Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource VisionCardBackground}"
                                BorderBrush="{DynamicResource VisionBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Card Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource VisionTextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding SourceSummary}" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <components:StatusBadge Grid.Column="1" Text="{Binding Status}" Status="{Binding Status}"/>
                                </Grid>

                                <!-- Operational Metrics -->
                                <Border Grid.Row="2" Background="{DynamicResource VisionSurface}" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Soluciones IA:" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            <TextBlock Text="{Binding ActiveAnalyticsSummary}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Rendimiento:" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            <TextBlock Text="{Binding FramesPerSecond, StringFormat='{}{0:0.0} FPS'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VisionAccent}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card Footer -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OperationalResultsSummary}"
                                               FontSize="10"
                                               Foreground="{DynamicResource VisionTextSecondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="Configurar"
                                            Command="{Binding DataContext.OpenCameraDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Operational Row: Alertas Recientes & Capacidad -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Alertas Operacionales Recientes -->
                <Border Grid.Column="0"
                        Background="{DynamicResource VisionCardBackground}"
                        BorderBrush="{DynamicResource VisionBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="ACTIVIDAD OPERACIONAL RECIENTE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource VisionTextSecondary}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="No hay alertas operacionales pendientes en este momento."
                                   Foreground="{DynamicResource VisionTextSecondary}"
                                   FontSize="12"
                                   Visibility="{Binding HasNoAlerts, Converter={StaticResource BooleanToVisibility}}"
                                   Margin="0,8,0,0"/>

                        <ItemsControl ItemsSource="{Binding FilteredAlerts}"
                                      Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource VisionBorder}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding SeverityBadgeBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeverityText}" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Message}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CameraId, StringFormat='{}Cámara: {0}'}" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CreatedAtFormatted}" FontSize="10" Foreground="{DynamicResource VisionTextSecondary}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Capacidad y Salud del Sistema -->
                <Border Grid.Column="2"
                        Background="{DynamicResource VisionCardBackground}"
                        BorderBrush="{DynamicResource VisionBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="CAPACIDAD Y RUNTIME DEL NODO"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource VisionTextSecondary}"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Estado del Sistema:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock Text="{Binding NodeStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionTextPrimary}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tiempo Activo:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock Text="{Binding UptimeText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionTextPrimary}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Acelerador IA:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock Text="{Binding ProcessorText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionAccent}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Estado Capacidad:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                            <TextBlock Text="{Binding CapacityStateText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VisionSuccess}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource VisionBorder}" Margin="0,0,0,10" />

                        <Button Content="Diagnóstico del Sistema"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="7"
                                Background="{DynamicResource VisionSurface}"
                                HorizontalAlignment="Right"
                                Padding="12,6"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Cursor="Hand" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
