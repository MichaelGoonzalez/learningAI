<UserControl x:Class="HandRaise.Desktop.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24" MaxWidth="700" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="Configuración del Sistema"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VisionTextPrimary}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Parámetros globales de VisionControl Edge, interfaz y hardware"
                       FontSize="12"
                       Foreground="{DynamicResource VisionTextSecondary}"
                       Margin="0,0,0,20"/>

            <!-- Node Identity Card -->
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="IDENTIDAD DEL SISTEMA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Node ID:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                        <TextBlock Text="{Binding NodeIdText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Site ID:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                        <TextBlock Text="{Binding SiteIdText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Versión:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                        <TextBlock Text="{Binding AboutText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Procesador / Aceleración:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                        <TextBlock Text="{Binding ProcessorText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VisionAccent}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance / Theme Card -->
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="APARIENCIA Y TEMA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tema de la Interfaz" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource VisionTextPrimary}"/>
                            <TextBlock Text="Alternar entre modo oscuro de alta fidelidad y modo claro" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding ThemeButtonText}"
                                Command="{Binding ToggleThemeCommand}"
                                Padding="14,6"
                                FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Host Control Card -->
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="CONTROL DEL SERVICIO EDGE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Estado del Servicio:" FontSize="12" Foreground="{DynamicResource VisionTextSecondary}"/>
                        <TextBlock Text="{Binding NodeStatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource VisionSuccess}" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ Iniciar Servicio" Command="{Binding StartNodeCommand}" Margin="0,0,10,0" Padding="14,6" FontWeight="SemiBold"/>
                        <Button Content="⏹ Detener Servicio" Command="{Binding StopNodeCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

