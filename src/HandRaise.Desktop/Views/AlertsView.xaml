<UserControl x:Class="HandRaise.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- Header with Title and Refresh button -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Alertas Operacionales"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VisionTextPrimary}"/>
                    <TextBlock Text="Eventos críticos, advertencias y anomalías detectadas en tiempo real"
                               FontSize="12"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Actualizar"
                        Command="{Binding RefreshAlertsCommand}"
                        Padding="14,6"
                        FontWeight="SemiBold"/>
            </Grid>

            <!-- Filter Controls Bar -->
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Severidad:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource VisionTextSecondary}"/>
                    <ComboBox Width="130" SelectedValue="{Binding SelectedAlertSeverityFilter}" SelectedValuePath="Content" Margin="0,0,16,0">
                        <ComboBoxItem Content="Todas" IsSelected="True"/>
                        <ComboBoxItem Content="Crítica"/>
                        <ComboBoxItem Content="Alta"/>
                        <ComboBoxItem Content="Media"/>
                        <ComboBoxItem Content="Baja"/>
                    </ComboBox>

                    <TextBlock Text="Estado:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource VisionTextSecondary}"/>
                    <ComboBox Width="130" SelectedValue="{Binding SelectedAlertStatusFilter}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Todas" IsSelected="True"/>
                        <ComboBoxItem Content="Abierta"/>
                        <ComboBoxItem Content="Reconocida"/>
                        <ComboBoxItem Content="Resuelta"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <components:EmptyState Title="No hay alertas registradas"
                                   Description="No se encontraron alertas activas que coincidan con los filtros seleccionados."
                                   Visibility="{Binding HasNoAlerts, Converter={StaticResource BooleanToVisibility}}"
                                   Margin="0,0,0,20"/>

            <!-- Alerts List -->
            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibility}}">
                <ItemsControl ItemsSource="{Binding FilteredAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource VisionBorder}" BorderThickness="0,0,0,1" Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{Binding SeverityBadgeBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SeverityText}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding CameraId}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RuleId}" VerticalAlignment="Center" Foreground="{DynamicResource VisionTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CreatedAtFormatted}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Ver cámara"
                                                Command="{Binding DataContext.OpenCameraByIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding CameraId}"
                                                Background="{DynamicResource VisionSurface}"
                                                Margin="0,0,6,0"
                                                Padding="8,4"
                                                FontSize="11"/>
                                        <Button Content="Reconocer" Command="{Binding AcknowledgeCommand}" IsEnabled="{Binding CanAcknowledge}" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                        <Button Content="Resolver" Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

