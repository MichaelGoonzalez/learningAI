<UserControl x:Class="HandRaise.Desktop.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:HandRaise.Desktop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Integraciones y Notificaciones"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VisionTextPrimary}"/>
                    <TextBlock Text="Destinos de salida (Webhooks HTTP, MQTT Brokers) y políticas de despacho"
                               FontSize="12"
                               Foreground="{DynamicResource VisionTextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Actualizar"
                        Command="{Binding RefreshIntegrationsCommand}"
                        Padding="14,6"
                        FontWeight="SemiBold"/>
            </Grid>

            <!-- Destinos de Notificación -->
            <TextBlock Text="Destinos de Notificación"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VisionTextPrimary}"
                       Margin="0,0,0,8"/>

            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">
                <Grid>
                    <components:EmptyState Title="Sin destinos configurados"
                                           Description="No se registran Webhooks HTTP ni brokers MQTT configurados en el sistema."
                                           Visibility="{Binding HasNoDestinations, Converter={StaticResource BooleanToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding Destinations}"
                                  Visibility="{Binding HasDestinations, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource VisionBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource VisionTextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TypeText}" VerticalAlignment="Center" Foreground="{DynamicResource VisionTextSecondary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Endpoint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Políticas de Alerta -->
            <TextBlock Text="Políticas de Notificación"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VisionTextPrimary}"
                       Margin="0,0,0,8"/>

            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">
                <Grid>
                    <components:EmptyState Title="Sin políticas configuradas"
                                           Description="No hay reglas de enrutamiento ni políticas de notificación asociadas."
                                           Visibility="{Binding HasNoPolicies, Converter={StaticResource BooleanToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding Policies}"
                                  Visibility="{Binding HasPolicies, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource VisionBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource VisionTextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MinSeverity, StringFormat='{}Min: {0}'}" VerticalAlignment="Center" Foreground="{DynamicResource VisionTextSecondary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DestinationIdsSummary, StringFormat='{}Destinos: {0}'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Intentos Recientes de Despacho -->
            <TextBlock Text="Intentos Recientes de Despacho"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VisionTextPrimary}"
                       Margin="0,0,0,8"/>

            <Border Background="{DynamicResource VisionCardBackground}"
                    BorderBrush="{DynamicResource VisionBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <components:EmptyState Title="Sin actividad reciente de despacho"
                                           Description="Los intentos de envío a endpoints remotos aparecerán reflejados aquí."
                                           Visibility="{Binding HasNoAttempts, Converter={StaticResource BooleanToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding Attempts}"
                                  Visibility="{Binding HasAttempts, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource VisionBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AttemptedAtFormatted}" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DestinationId}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Error}" Foreground="{DynamicResource VisionDanger}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding DurationMs, StringFormat='{}{0:0} ms'}" FontSize="11" Foreground="{DynamicResource VisionTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

