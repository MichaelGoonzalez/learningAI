<UserControl x:Class="HandRaise.Desktop.Components.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400"
             x:Name="RootEmptyState">
    <Border Background="{DynamicResource SurfaceAlt}" 
            BorderBrush="{DynamicResource BorderSubtle}" 
            BorderThickness="1" 
            CornerRadius="10" 
            Padding="32,24" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            MaxWidth="460">
        <StackPanel HorizontalAlignment="Center">
            <!-- Icon container -->
            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceElevated}" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                      Fill="{DynamicResource SecondaryText}" 
                      Stretch="Uniform" 
                      Width="20" Height="20" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            
            <TextBlock Text="{Binding Title, ElementName=RootEmptyState}" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       Foreground="{DynamicResource PrimaryText}" 
                       Margin="0,0,0,6" />
            
            <TextBlock Text="{Binding Message, ElementName=RootEmptyState}" 
                       FontSize="13" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Foreground="{DynamicResource SecondaryText}" 
                       Margin="0,0,0,16" />
            
            <Button Content="{Binding ActionText, ElementName=RootEmptyState}" 
                    Command="{Binding ActionCommand, ElementName=RootEmptyState}" 
                    Visibility="{Binding HasAction, ElementName=RootEmptyState, Converter={StaticResource BooleanToVisibility}}" 
                    HorizontalAlignment="Center" 
                    Padding="18,8" />
        </StackPanel>
    </Border>
</UserControl>

