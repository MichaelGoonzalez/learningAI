<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Spacing Scale (4, 8, 12, 16, 24, 32) -->
    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>

    <!-- Thickness Presets -->
    <Thickness x:Key="Thickness4">4</Thickness>
    <Thickness x:Key="Thickness8">8</Thickness>
    <Thickness x:Key="Thickness12">12</Thickness>
    <Thickness x:Key="Thickness16">16</Thickness>
    <Thickness x:Key="Thickness24">24</Thickness>
    <Thickness x:Key="Thickness32">32</Thickness>

    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingCompact">12</Thickness>
    <Thickness x:Key="ModalPadding">24</Thickness>

    <!-- Corner Radii -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">12</CornerRadius>
</ResourceDictionary>

