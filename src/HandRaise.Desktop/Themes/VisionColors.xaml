<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base Graphite Colors -->
    <Color x:Key="WindowBackgroundColor">#0D1117</Color>
    <Color x:Key="SurfaceColor">#161B22</Color>
    <Color x:Key="SurfaceAltColor">#21262D</Color>
    <Color x:Key="SurfaceElevatedColor">#30363D</Color>
    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="BorderSubtleColor">#21262D</Color>

    <!-- Brand / Status Colors -->
    <Color x:Key="AccentColor">#58A6FF</Color>
    <Color x:Key="AccentHoverColor">#79C0FF</Color>
    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="WarningColor">#D29922</Color>
    <Color x:Key="DangerColor">#F85149</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#F0F6FC</Color>
    <Color x:Key="SecondaryTextColor">#8B949E</Color>
    <Color x:Key="MutedTextColor">#6E7681</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
</ResourceDictionary>

