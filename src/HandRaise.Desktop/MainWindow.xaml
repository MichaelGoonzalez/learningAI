<Window x:Class="HandRaise.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HandRaise.Desktop.Controls"
        xmlns:viewModels="clr-namespace:HandRaise.Desktop.ViewModels"
        Title="VisionControl Edge"
        Width="1480" Height="920" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavigationSidebar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,4" Cursor="Hand">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SecondaryText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Radio -->
        <Style x:Key="SegmentedTabRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,8" Cursor="Hand">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="10" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Subtitle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Accent}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                        <TextBlock Text="VC" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding AppTitle}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding AppSubtitle}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="10,4" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding NodeStatusBadgeBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NodeStatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Device Selector -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Dispositivo IA:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,8,0" FontSize="12" />
                    <ComboBox Width="280" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" />
                    <Button Content="Aplicar" Command="{Binding SwitchDeviceCommand}" Margin="6,0,0,0" Padding="10,5" FontSize="12" />
                </StackPanel>

                <!-- Theme Toggle -->
                <Button Grid.Column="5" Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center" Padding="10,6" FontSize="12" />
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="10" Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="NAVEGACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="6,0,0,8" />
                        <RadioButton Content="📊 Resumen" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsOverviewSelected}" />
                        <RadioButton Content="📹 Cámaras" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsCamerasSelected}" />
                        <RadioButton Content="🔔 Alertas" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsAlertsSelected}" />
                        <RadioButton Content="🔌 Integraciones" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsIntegrationsSelected}" />
                        <RadioButton Content="🧠 Modelos IA" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsModelsSelected}" />
                        <RadioButton Content="⚙️ Sistema" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsSystemSelected}" />
                        <RadioButton Content="🌐 Conexión Web" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsWebConnectionSelected}" />
                        <RadioButton Content="🩺 Diagnóstico" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsDiagnosticsSelected}" />
                    </StackPanel>

                    <!-- Bottom Sidebar Status Summary -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="ESTADO GLOBAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ActiveCamerasCountText}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalActiveAnalyticsCount, StringFormat={}{0} analíticas activas}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding AggregateFps, StringFormat={}{0:0.0} FPS total}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN CONTENT SWITCHER -->
            <Grid Grid.Column="2">

                <!-- 0. RESUMEN (OVERVIEW) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOverviewSelected, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <!-- KPI CARDS ROW -->
                        <UniformGrid Columns="4" Margin="0,0,0,14">
                            <!-- Card 1: Cámaras -->
                            <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CÁMARAS ACTIVAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding RunningCamerasCount, StringFormat={}{0}}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TotalCamerasCount, StringFormat={}de {0} configuradas}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Analíticas -->
                            <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ANALÍTICAS ACTIVAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding TotalActiveAnalyticsCount, StringFormat={}{0}}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                                    <TextBlock Text="En todas las cámaras" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Alertas -->
                            <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ALERTAS ABIERTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding OpenAlertsCount, StringFormat={}{0}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Warning}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CriticalAlertsCount, StringFormat={}{0} críticas}" FontSize="11" Foreground="{DynamicResource Danger}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: FPS & Dispositivo -->
                            <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="RENDIMIENTO GLOBAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding AggregateFps, StringFormat={}{0:0.0} FPS}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Success}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CapacityStateText, StringFormat={}Capacidad: {0}}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Quick Cameras Mosaic -->
                        <TextBlock Text="CÁMARAS REGISTRADAS" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Cameras}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="130" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding SourceType}" FontSize="10" Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                            <Border Grid.Row="2" Background="#0A0D10" CornerRadius="4">
                                                <Grid>
                                                    <TextBlock Text="Esperando video" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                                    <Image Source="{Binding VideoImage}" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FramesPerSecond, StringFormat={}{0:0.0} FPS}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                                                <Button Grid.Column="1" Content="Abrir detalle" Command="{Binding DataContext.OpenCameraDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" FontSize="11" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1. CÁMARAS (CAMERAS LIST / MOSAIC) -->
                <Grid Visibility="{Binding IsCamerasSelected, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ADMINISTRACIÓN DE CÁMARAS" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Visualice transmisiones, configure zonas y asigne analíticas en tiempo real." Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Añadir cámara" Command="{Binding ShowAddCameraModalCommand}" Padding="12,6" FontWeight="Bold" />
                    </Grid>

                    <!-- Camera Mosaic Cards -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cameras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="220" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding SourceDescription}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding FramesPerSecond, StringFormat={}{0:0.0} FPS}" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Video image feed with overlay -->
                                            <Border Grid.Row="2" Background="#080A0D" CornerRadius="6">
                                                <Grid>
                                                    <TextBlock Text="Esperando señal de video" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding VideoImage}" Stretch="Uniform" />
                                                    <controls:ZoneEditorOverlay Zones="{Binding EditorZones}" Lines="{Binding EditorLines}" DraftPoints="{Binding DraftPoints}" Editing="{Binding IsEditingZones}" FrameWidth="{Binding FrameWidth}" FrameHeight="{Binding FrameHeight}" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding ActiveAnalyticsCount, StringFormat={}{0} analíticas}" FontSize="11" />
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding SourceType}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Abrir Detalle" Command="{Binding DataContext.OpenCameraDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0" Padding="10,5" />
                                                    <Button Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" Padding="10,5" Background="{DynamicResource SurfaceAlt}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 2. ALERTAS (ALERTS) -->
                <Grid Visibility="{Binding IsAlertsSelected, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CENTRO DE ALERTAS OPERATIVAS" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Monitoreo de incidentes generados por reglas analíticas." Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Actualizar alertas" Command="{Binding RefreshAlertsCommand}" Padding="10,5" />
                    </Grid>

                    <!-- Filters Row -->
                    <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Severidad:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryText}" />
                            <ComboBox Width="120" SelectedValue="{Binding SelectedAlertSeverityFilter}" SelectedValuePath="Content" Margin="0,0,16,0">
                                <ComboBoxItem Content="Todas" IsSelected="True" />
                                <ComboBoxItem Content="Critical" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="Low" />
                            </ComboBox>

                            <TextBlock Text="Estado:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryText}" />
                            <ComboBox Width="130" SelectedValue="{Binding SelectedAlertStatusFilter}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Todas" IsSelected="True" />
                                <ComboBoxItem Content="Abierta" />
                                <ComboBoxItem Content="Reconocida" />
                                <ComboBoxItem Content="Resuelta" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Alerts List -->
                    <Border Grid.Row="4" Background="{DynamicResource Surface}" CornerRadius="8" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{Binding SeverityBadgeBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SeverityText}" FontWeight="Bold" FontSize="11" Foreground="White" />
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding CameraId}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding RuleId}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="4" Text="{Binding CreatedAtFormatted}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" />

                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Reconocer" Command="{Binding AcknowledgeCommand}" IsEnabled="{Binding CanAcknowledge}" Margin="0,0,6,0" Padding="8,4" FontSize="11" Background="{DynamicResource SurfaceAlt}" />
                                                    <Button Content="Resolver" Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" Padding="8,4" FontSize="11" Background="{DynamicResource SurfaceAlt}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 3. INTEGRACIONES (INTEGRATIONS) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsIntegrationsSelected, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INTEGRACIONES Y NOTIFICACIONES" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Administración de destinos (Webhook HTTP, MQTT), políticas de alerta e intentos de entrega." Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Actualizar" Command="{Binding RefreshIntegrationsCommand}" Padding="10,5" />
                        </Grid>

                        <!-- Destinos -->
                        <TextBlock Text="DESTINOS DE NOTIFICACIÓN" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding Destinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Endpoint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Políticas -->
                        <TextBlock Text="POLÍTICAS DE NOTIFICACIÓN" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding Policies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding MinSeverity, StringFormat={}Min: {0}}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                <TextBlock Grid.Column="2" Text="{Binding DestinationIdsSummary, StringFormat={}Destinos: {0}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Intentos de envío -->
                        <TextBlock Text="INTENTOS RECIENTES DE DISPACHO" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12">
                            <ItemsControl ItemsSource="{Binding Attempts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AttemptedAtFormatted}" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DestinationId}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding DurationMs, StringFormat={}{0:0} ms}" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. MODELOS (MODELS & RUNTIME) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsModelsSelected, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CATÁLOGO DE MODELOS Y RUNTIME DE INFERENCIA" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Modelos registrados, capacidades compartidas y asignación por cámara." Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Actualizar" Command="{Binding RefreshModelsCommand}" Padding="10,5" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Id, StringFormat={}ID: {0}}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding Version, StringFormat={}v{0}}" FontWeight="SemiBold" FontSize="11" />
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Formato:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding Format}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Resolución:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding Resolution}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Memoria est.:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding MemoryMb}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="Capacidades:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding CapabilitiesSummary}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. SISTEMA (SYSTEM) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSystemSelected, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="INFORMACIÓN Y MÉTRICAS DEL SISTEMA" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Parámetros del nodo, hardware y estado de ejecución." Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,0,12" />

                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Nodo ID:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NodeIdText}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="2" Text="Sitio ID:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteIdText}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="4" Text="Plataforma:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Windows x64 · .NET 10 Runtime" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="6" Text="Aceleración:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProcessorText}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="8" Text="Tiempo activo:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding UptimeText}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="10" Text="Versión Software:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding AboutText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. CONEXIÓN WEB (WEB CONNECTION) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsWebConnectionSelected, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="CONEXIÓN CON MÓDULO WEB" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Datos necesarios para vincular VisionControl Console React o clientes externos con este nodo de visión." Foreground="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Status Box -->
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Estado API:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding NodeStatusBadgeBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ApiStatusText}" FontWeight="SemiBold" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Nodo:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NodeIdText}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="4" Text="Sitio:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SiteIdText}" />
                            </Grid>
                        </Border>

                        <!-- Access Mode -->
                        <TextBlock Text="MODO DE ACCESO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <RadioButton Content="Solo este PC (Localhost · 127.0.0.1)" IsChecked="{Binding IsLocalOnlyAccess}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <RadioButton Content="Red local (LAN · otros equipos de la red)" IsChecked="{Binding IsLanAccess}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Addresses -->
                        <TextBlock Text="DIRECCIONES DE CONEXIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Dirección local:" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
                                <Grid Margin="0,3,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LocalAddressText, Mode=OneWay}" IsReadOnly="True" Padding="6" Background="{DynamicResource SurfaceAlt}" />
                                    <Button Grid.Column="1" Content="Copiar" Command="{Binding CopyAddressCommand}" Margin="6,0,0,0" />
                                </Grid>

                                <TextBlock Text="Dirección LAN (Red local):" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LanAddressText, Mode=OneWay}" IsReadOnly="True" Padding="6" Background="{DynamicResource SurfaceAlt}" />
                                    <Button Grid.Column="1" Content="Copiar" Command="{Binding CopyLanAddressCommand}" IsEnabled="{Binding HasLanAddress}" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- API Key -->
                        <TextBlock Text="CLAVE DE ACCESO (API KEY)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBox Text="{Binding ApiKeyMasked, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="6" Background="{DynamicResource SurfaceAlt}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="{Binding ApiKeyVisibilityButtonText}" Command="{Binding ToggleApiKeyVisibilityCommand}" Background="{DynamicResource SurfaceAlt}" />
                                    <Button Grid.Column="2" Content="Copiar clave" Command="{Binding CopyApiKeyCommand}" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Button Content="Copiar configuración para React (JSON)" Command="{Binding CopyConfigurationCommand}" Padding="12" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                        <Button Content="Regenerar clave de acceso" Command="{Binding RegenerateApiKeyCommand}" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource SecondaryText}" FontSize="11" Padding="6" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 7. DIAGNÓSTICO (DIAGNOSTICS) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDiagnosticsSelected, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="DIAGNÓSTICO DEL NODO" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Inspección de salud, subsistemas de inferencia y almacenamiento." Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,0,12" />

                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Preparación:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReadinessText}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="2" Text="Hardware activo:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProcessorText}" />

                                <TextBlock Grid.Row="4" Text="Tiempo activo:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UptimeText}" />

                                <TextBlock Grid.Row="6" Text="Versión:" Foreground="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AboutText}" />
                            </Grid>
                        </Border>

                        <Button Content="Actualizar diagnóstico" Command="{Binding RefreshDiagnosticsCommand}" Padding="10,6" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 8. DETALLE DE CÁMARA (CAMERA DETAIL) -->
                <Grid Visibility="{Binding IsCameraDetailSelected, Converter={StaticResource BooleanToVisibility}}" DataContext="{Binding SelectedDetailCamera}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Detail Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="← Volver a cámaras" Command="{Binding DataContext.BackToCamerasCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,5" Background="{DynamicResource SurfaceAlt}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding SourceDescription}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" Padding="12,6" />
                        </StackPanel>
                    </Grid>

                    <!-- Main Detail Split: Left Live Feed / Right Tabs -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live Video with Overlay -->
                        <Border Background="#080A0D" CornerRadius="10" Padding="4">
                            <Grid>
                                <TextBlock Text="Esperando señal de video..." Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding VideoImage}" Stretch="Uniform" />
                                <controls:ZoneEditorOverlay Zones="{Binding EditorZones}" Lines="{Binding EditorLines}" DraftPoints="{Binding DraftPoints}" Editing="{Binding IsEditingZones}" FrameWidth="{Binding FrameWidth}" FrameHeight="{Binding FrameHeight}" />
                            </Grid>
                        </Border>

                        <!-- Right: Detail Tabs Panel -->
                        <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Tabs Selector -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="3">
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="Analíticas" Style="{StaticResource SegmentedTabRadio}" IsChecked="{Binding IsAnalyticsTabSelected}" />
                                        <RadioButton Content="Zonas / Líneas" Style="{StaticResource SegmentedTabRadio}" IsChecked="{Binding IsZonesTabSelected}" />
                                        <RadioButton Content="Config" Style="{StaticResource SegmentedTabRadio}" IsChecked="{Binding IsConfigTabSelected}" />
                                    </UniformGrid>
                                </Border>

                                <!-- TAB 1: ANALÍTICAS -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAnalyticsTabSelected, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="ANALÍTICAS ACTIVAS" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding AssignedAnalytics}" Margin="0,0,0,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11" />
                                                            </Grid>
                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button Content="Alternar" Command="{Binding ToggleEnabledCommand}" Margin="0,0,6,0" Padding="6,3" FontSize="10" Background="{DynamicResource Surface}" />
                                                                    <Button Content="Eliminar" Command="{Binding RemoveCommand}" Padding="6,3" FontSize="10" Background="{DynamicResource Danger}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add Analytic from Catalog -->
                                        <TextBlock Text="AÑADIR DEL CATÁLOGO" FontSize="12" FontWeight="Bold" Margin="0,6,0,6" />
                                        <ComboBox ItemsSource="{Binding AvailableCatalog}" SelectedItem="{Binding SelectedCatalogAnalytic}" DisplayMemberPath="DisplayName" Margin="0,0,0,6" />
                                        <Button Content="+ Añadir a esta cámara" Command="{Binding AddAnalyticCommand}" Padding="8,5" FontWeight="Bold" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- TAB 2: ZONAS Y LÍNEAS -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsZonesTabSelected, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="ZONAS POLIGONALES" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                                        <Button Content="{Binding ZoneEditorButtonText}" Command="{Binding ToggleZoneEditorCommand}" Margin="0,0,0,8" />

                                        <StackPanel Visibility="{Binding IsEditingZones, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <ComboBox Width="140" ItemsSource="{Binding EditorZones}" SelectedItem="{Binding SelectedZone}" DisplayMemberPath="Name" />
                                                <Button Content="Nueva" Command="{Binding NewZoneCommand}" Margin="6,0,0,0" Padding="6,4" />
                                            </StackPanel>
                                            <TextBox Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource SurfaceAlt}" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Content="Cerrar polígono" Command="{Binding CloseZoneCommand}" Padding="6,4" />
                                                <Button Content="Deshacer" Command="{Binding UndoZoneCommand}" Margin="6,0,0,0" Padding="6,4" />
                                                <Button Content="Borrar" Command="{Binding DeleteZoneCommand}" Margin="6,0,0,0" Padding="6,4" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ZoneMessage}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Text="LÍNEAS (TRIPWIRES)" FontSize="13" FontWeight="Bold" Margin="0,10,0,6" />
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBox Text="{Binding NewLineName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource SurfaceAlt}" Margin="0,0,0,6" />
                                            <Button Content="+ Crear Línea" Command="{Binding AddLineCommand}" Padding="6,4" />
                                            <TextBlock Text="{Binding LineMessage}" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- TAB 3: CONFIGURACIÓN & RUNTIME -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsConfigTabSelected, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="CONFIGURACIÓN DE CÁMARA" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                                        <TextBlock Text="Nombre:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource SurfaceAlt}" Margin="0,2,0,8" />

                                        <TextBlock Text="Fuente de video:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBox Text="{Binding EditSource, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource SurfaceAlt}" Margin="0,2,0,8" />

                                        <CheckBox Content="Iniciar automáticamente" IsChecked="{Binding EditEnabled}" FontWeight="SemiBold" Margin="0,4,0,12" />
                                        <Button Content="Guardar cambios" Command="{Binding SaveConfigCommand}" Padding="8,5" FontWeight="Bold" Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding ConfigMessage}" FontSize="11" Foreground="{DynamicResource Success}" Margin="0,0,0,12" />

                                        <TextBlock Text="PLAN DE RUNTIME" FontSize="13" FontWeight="Bold" Margin="0,8,0,4" />
                                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RuntimePlanSummary}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RequiredCapabilitiesSummary, StringFormat={}Capacidades: {0}}" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ModelProviderSummary, StringFormat={}Provider: {0}}" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL: AÑADIR CÁMARA OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#AA000000" Visibility="{Binding IsAddCameraModalOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="AÑADIR NUEVA CÁMARA" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Configure una cámara USB, RTSP o archivo local." Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,0,14" />

                    <TextBlock Text="Nombre descriptivo:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                    <TextBox Text="{Binding NewCameraName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" Margin="0,3,0,10" />

                    <TextBlock Text="Tipo de cámara:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                    <ComboBox SelectedValue="{Binding NewCameraType}" SelectedValuePath="Content" Margin="0,3,0,10">
                        <ComboBoxItem Content="USB (Cámara web)" IsSelected="True" />
                        <ComboBoxItem Content="RTSP (Cámara IP)" />
                        <ComboBoxItem Content="Archivo de video" />
                    </ComboBox>

                    <TextBlock Text="Fuente (Índice USB '0', 'rtsp://...', o ruta archivo):" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                    <TextBox Text="{Binding NewCameraSource, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" Margin="0,3,0,10" />

                    <CheckBox Content="Iniciar transmisión automáticamente" IsChecked="{Binding NewCameraAutoStart}" FontWeight="SemiBold" Margin="0,4,0,14" />

                    <TextBlock Text="{Binding AddCameraError}" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,0,0,10" Visibility="{Binding AddCameraError, Converter={StaticResource BooleanToVisibility}}" />

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="Cancelar" Command="{Binding CloseAddCameraModalCommand}" Background="{DynamicResource SurfaceAlt}" Padding="10" />
                        <Button Grid.Column="2" Content="Añadir cámara" Command="{Binding AddCameraCommand}" Padding="10" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Grid Grid.Row="3" Margin="4,10,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
            <TextBlock Grid.Column="1" Text="{Binding AboutText}" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
        </Grid>
    </Grid>
</Window>
