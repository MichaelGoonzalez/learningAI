<Window x:Class="HandRaise.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HandRaise.Desktop.Controls"
        xmlns:viewModels="clr-namespace:HandRaise.Desktop.ViewModels"
        xmlns:views="clr-namespace:HandRaise.Desktop.Views"
        xmlns:components="clr-namespace:HandRaise.Desktop.Components"
        Title="VisionControl Edge"
        Width="1480" Height="920" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseAddCameraModalCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <!-- Nav Button Style -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavigationSidebar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8" Margin="0,0,0,3" Cursor="Hand">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <!-- 1. INITIALIZING STATE (While services boot) -->
        <Border Visibility="{Binding IsLoadingInitialState, Converter={StaticResource BooleanToVisibility}}"
                Background="{DynamicResource WindowBackground}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,32"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Iniciando sistema..."
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Cargando configuración y telemetría de cámaras..."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 2. FULL-SCREEN FIRST RUN EXPERIENCE (Dedicated wizard when 0 cameras) -->
        <views:FirstRunView Visibility="{Binding ShowFirstRunExperience, Converter={StaticResource BooleanToVisibility}}" />

        <!-- 3. NATIVE APPLICATION SHELL (Visible when >= 1 camera is configured) -->
        <Grid Margin="16" Visibility="{Binding ShowApplicationShell, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="10" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand & Subtitle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Accent}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="VC" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding AppTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                            <TextBlock Text="{Binding AppSubtitle}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badge -->
                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="10,4" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding NodeStatusBadgeBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NodeStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Theme Toggle -->
                    <Button Grid.Column="3" Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center" Padding="12,6" FontSize="11" Cursor="Hand" />
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR NAVIGATION RAIL -->
                <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="10" Padding="10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Primary Nav Items -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="OPERACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="8,4,0,6" />
                                <RadioButton Content="Inicio" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsOverviewSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="0" />
                                <RadioButton Content="Cámaras" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsCamerasSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="1" />
                                <RadioButton Content="Métricas" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsMetricsSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="2" />
                                <RadioButton Content="Entrenamiento de Modelos" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsTrainingSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="10" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Subtle Divider -->
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="4,8" />

                        <!-- Bottom Settings Link -->
                        <StackPanel Grid.Row="2">
                            <RadioButton Content="⚙ Configuración" Style="{StaticResource NavRadioButton}" IsChecked="{Binding IsSettingsOrTechnicalSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT MAIN CONTENT SWITCHER -->
                <Grid Grid.Column="2">
                    <!-- 0. RESUMEN / INICIO (OVERVIEW) -->
                    <views:OverviewView Visibility="{Binding IsOverviewSelected, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- 1. CÁMARAS (ADMINISTRACIÓN) -->
                    <views:CamerasView Visibility="{Binding IsCamerasSelected, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- 2. MÉTRICAS (SUPERVISIÓN) -->
                    <views:MetricsView Visibility="{Binding IsMetricsSelected, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- 4, 5, 6, 9. CONFIGURACIÓN (SETTINGS) -->
                    <views:SettingsView Visibility="{Binding IsSettingsOrTechnicalSelected, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- 7. DIAGNÓSTICO DEL SISTEMA (ACCESO DESDE INICIO) -->
                    <views:DiagnosticsView Visibility="{Binding IsDiagnosticsSelected, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- 8. DETALLE DE CÁMARA (CAMERA WORKSPACE) -->
                    <views:CameraWorkspaceView Visibility="{Binding IsCameraDetailSelected, Converter={StaticResource BooleanToVisibility}}" />
                    <views:TrainingLabView DataContext="{Binding TrainingLab}" Visibility="{Binding DataContext.IsTrainingSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Grid>

            <!-- BOTTOM STATUS BAR -->
            <Grid Grid.Row="3" Margin="4,8,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding AboutText}" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
            </Grid>
        </Grid>

        <!-- 4. MODAL: ASISTENTE AÑADIR CÁMARA (For adding subsequent cameras from shell) -->
        <Grid Background="#CC000000" Visibility="{Binding IsAddCameraModalOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Wizard Header -->
                    <TextBlock Text="Añadir cámara" FontSize="18" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Text="Selecciona cómo se conecta la fuente de video." Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,0,14" />

                    <!-- Step Indicators -->
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="4" Margin="0,0,0,16">
                        <UniformGrid Columns="4">
                            <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="6,4" Visibility="{Binding IsWizardStep1, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="1. Origen" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="1. Origen" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="{Binding IsWizardStep1, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}" />

                            <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="6,4" Visibility="{Binding IsWizardStep2, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="2. Configuración" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="2. Configuración" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="{Binding IsWizardStep2, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}" />

                            <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="6,4" Visibility="{Binding IsWizardStep3, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="3. Probar" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="3. Probar" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="{Binding IsWizardStep3, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}" />

                            <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="6,4" Visibility="{Binding IsWizardStep4, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="4. Guardar" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="4. Guardar" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="{Binding IsWizardStep4, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}" />
                        </UniformGrid>
                    </Border>

                    <!-- STEP 1: SELECCIÓN DE ORIGEN (CARDS) -->
                    <StackPanel Visibility="{Binding IsWizardStep1, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Seleccione el tipo de fuente de video:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                        <!-- USB Card -->
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <RadioButton IsChecked="{Binding IsWizardUsb}" GroupName="WizardSourceGroup" VerticalAlignment="Center">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="USB / Cámara local" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="Cámaras web integradas o dispositivos de captura conectados por USB." FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- RTSP Card -->
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <RadioButton IsChecked="{Binding IsWizardRtsp}" GroupName="WizardSourceGroup" VerticalAlignment="Center">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Cámara IP / RTSP" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="Cámaras de seguridad de red, grabadores NVR o flujos RTSP/RTSPS." FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- File Card -->
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <RadioButton IsChecked="{Binding IsWizardFile}" GroupName="WizardSourceGroup" VerticalAlignment="Center">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Archivo de video" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="Archivos de video locales (MP4, MKV, AVI) para pruebas o analítica offline." FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </StackPanel>

                    <!-- STEP 2: PARÁMETROS DE CONFIGURACIÓN -->
                    <StackPanel Visibility="{Binding IsWizardStep2, Converter={StaticResource BooleanToVisibility}}">
                        <!-- USB Parameters -->
                        <StackPanel Visibility="{Binding IsWizardUsb, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Configuración de Cámara USB / Local" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                            <TextBlock Text="Dispositivo de video disponible:" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DetectedUsbDevices}" SelectedItem="{Binding SelectedUsbDevice}" DisplayMemberPath="DisplayName" Padding="8,6" />
                                <Button Grid.Column="2" Content="Actualizar dispositivos" Command="{Binding RefreshUsbDevicesCommand}" Padding="10,6" FontSize="11" />
                            </Grid>

                            <Expander Header="Configuración técnica avanzada (índice manual)" FontSize="11" Foreground="{DynamicResource SecondaryText}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Índice de dispositivo DirectShow / MediaFoundation:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBox Text="{Binding WizardUsbIndex, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" Margin="0,3,0,6" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- RTSP Parameters -->
                        <StackPanel Visibility="{Binding IsWizardRtsp, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Configuración de Cámara IP / RTSP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                            <TextBlock Text="Dirección RTSP (ej: rtsp://192.168.1.50:554/stream1):" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding WizardRtspUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Usuario (opcional):" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WizardRtspUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Contraseña (opcional):" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WizardRtspPassword, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- File Parameters -->
                        <StackPanel Visibility="{Binding IsWizardFile, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Configuración de Archivo de Video" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                            <Button Content="Seleccionar archivo de video..." Command="{Binding BrowseVideoFileCommand}" Padding="14,8" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,10" />

                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                                    Visibility="{Binding IsFileSelected, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Archivo:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock Text="{Binding FileNameOnly}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Formato:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock Text="{Binding FileExtensionOnly}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding WizardFilePath}" FontSize="10" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <CheckBox Content="Repetir video automáticamente al finalizar (Loop)" IsChecked="{Binding LoopVideoFile}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        </StackPanel>
                    </StackPanel>

                    <!-- STEP 3: PROBAR CÁMARA -->
                    <StackPanel Visibility="{Binding IsWizardStep3, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Prueba de conexión con la cámara:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                        <!-- Preview Frame from Probe -->
                        <Border Background="#0A0D10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Height="180" Margin="0,0,0,10">
                            <Grid>
                                <!-- Placeholder when waiting for frame -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasTestPreviewImage, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}">
                                    <TextBlock Text="📹" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.4"/>
                                    <TextBlock Text="Sin señal de vista previa" Foreground="#667085" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Iniciando vista previa en vivo..." Foreground="#475467" HorizontalAlignment="Center" FontSize="10" Margin="0,2,0,0"
                                               Visibility="{Binding IsTestingConnection, Converter={StaticResource BooleanToVisibility}}"/>
                                </StackPanel>

                                <!-- Live Video Image -->
                                <Image Source="{Binding TestPreviewImage}" Stretch="Uniform" />

                                <!-- "VIDEO EN VIVO" Green Status Badge (Top-Left) -->
                                <Border Background="#D90F172A" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                        Visibility="{Binding IsProbeStreaming, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="VIDEO EN VIVO" FontSize="9" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Telemetry Bar (Bottom Overlay) -->
                                <Border Background="#E6090D14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5" VerticalAlignment="Bottom"
                                        Visibility="{Binding IsProbeStreaming, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Res: " FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ProbeResolutionText}" FontSize="9" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="FPS: " FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ProbeFpsText}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Lat: " FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding ProbeLatencyText}" FontSize="9" FontWeight="SemiBold" Foreground="#34D399" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Probe Status Card -->
                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding EffectiveWizardSource, StringFormat='Origen: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding TestConnectionMessage, TargetNullValue='Preparado para probar.'}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding TestConnectionDetails}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />

                                <!-- Technical Details Expander -->
                                <Expander Header="Ver detalles técnicos del diagnóstico" Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0" FontSize="11">
                                    <TextBox Text="{Binding TestTechnicalDetails, Mode=OneWay}" IsReadOnly="True" Background="#0A0D10" Foreground="#E2E8F0" Padding="6" FontSize="10" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Probe Action Button -->
                        <Grid Margin="0,0,0,8">
                            <Button Content="Probar cámara" Command="{Binding TestWizardConnectionCommand}" IsEnabled="{Binding IsNotTestingConnection}" Padding="14,7" FontWeight="Bold" HorizontalAlignment="Left" />
                        </Grid>

                        <!-- Advanced Save Option Expander -->
                        <Expander Header="Opciones avanzadas" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox Content="Guardar sin probar la conexión" IsChecked="{Binding AllowSaveWithoutProbe}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="La cámara se guardará sin comprobar previamente que la fuente de video esté disponible." FontSize="10" Foreground="{DynamicResource MutedText}" Margin="18,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- STEP 4: RESUMEN Y GUARDAR -->
                    <StackPanel Visibility="{Binding IsWizardStep4, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Identidad y confirmación:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                        <TextBlock Text="Nombre operativo de la cámara:" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding NewCameraName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{DynamicResource SurfaceAlt}" Margin="0,0,0,10" />

                        <CheckBox Content="Iniciar transmisión automáticamente al arrancar" IsChecked="{Binding NewCameraAutoStart}" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Resumen de la cámara:" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tipo de origen:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding WizardSourceType}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Origen:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding EffectiveWizardSource}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Estado de prueba:" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Text="{Binding TestConnectionMessage, TargetNullValue='Sin probar'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Error Text -->
                    <TextBlock Text="{Binding AddCameraError}" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,4,0,10" Visibility="{Binding AddCameraError, Converter={StaticResource BooleanToVisibility}}" TextWrapping="Wrap" />

                    <!-- Wizard Buttons Navigation Bar -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="Cancelar" Command="{Binding CloseAddCameraModalCommand}" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="12,6" />

                        <Button Grid.Column="2" Content="← Anterior" Command="{Binding PrevWizardStepCommand}" Visibility="{Binding IsWizardStep1, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}" Background="{DynamicResource SurfaceAlt}" Padding="12,6" />

                        <Button Grid.Column="4" Content="Siguiente →" Command="{Binding NextWizardStepCommand}" Visibility="{Binding IsWizardStep4, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}" Padding="14,6" FontWeight="Bold" />

                        <Button Grid.Column="4" Content="Guardar cámara" Command="{Binding SaveWizardCameraCommand}" Visibility="{Binding IsWizardStep4, Converter={StaticResource BooleanToVisibility}}" Padding="14,6" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
