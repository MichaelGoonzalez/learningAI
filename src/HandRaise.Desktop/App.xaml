<Application x:Class="HandRaise.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HandRaise.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/VisionColors.xaml" />
                <ResourceDictionary Source="Themes/VisionTypography.xaml" />
                <ResourceDictionary Source="Themes/VisionSpacing.xaml" />
                <ResourceDictionary Source="Themes/VisionControls.xaml" />
                <ResourceDictionary Source="Themes/VisionMotion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />

            <!-- Global Window & Text Styles -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource VisionPrimaryButton}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource VisionTextBox}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource VisionComboBox}" />
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource VisionComboBoxItem}" />

            <Style TargetType="DatePicker">
                <Setter Property="Padding" Value="5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

