# Copia este archivo como .env. Las variables usan el prefijo HAND_RAISE__
# y doble guion bajo para representar niveles de config.yaml.

HAND_RAISE__MODEL__DEVICE=auto
HAND_RAISE__MODEL__WEIGHTS=yolo26n-pose.pt
HAND_RAISE__STORAGE__DATABASE_URL=sqlite:///./data/hand_raise.db
HAND_RAISE__STORAGE__SNAPSHOTS_DIR=./data/snapshots
HAND_RAISE__API__API_KEY=
CAMERA_DEMO_SOURCE=./videos/demo.mp4

# Las listas y booleanos se interpretan como YAML.
# HAND_RAISE__API__CORS_ORIGINS=["http://localhost:4200", "http://localhost:3000"]
# HAND_RAISE__DETECTION__STRICT_MODE=true
